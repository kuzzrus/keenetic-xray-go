[Unit]
Description=keenetic-xray control server (Telegram bot and router command queue)
Documentation=https://github.com/kuzzrus/keenetic-xray-go/blob/main/docs/bot-control-design.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keenetic-xray
Group=keenetic-xray
Environment=KEENETIC_XRAY_CS_CONFIG=/etc/keenetic-xray-control-server/config.json
ExecStart=/usr/local/bin/keenetic-xray-control-server
Restart=on-failure
RestartSec=5

# Only exercised when config.json sets "domain": the process binds :80
# itself (no reverse proxy) to answer Let's Encrypt's HTTP-01 challenge
# for ACME certificate issuance/renewal -- a privileged port an
# unprivileged user can't bind without this. Compatible with
# NoNewPrivileges=yes below: ambient capabilities are exactly the
# mechanism systemd recommends for this, unlike setuid-style escalation.
# A no-domain deployment never binds :80, so granting this ahead of time
# costs it nothing in practice -- it's simply unused.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The process only ever reads its config and TLS material under
# /etc/keenetic-xray-control-server and reads/writes its queue file under
# /var/lib/keenetic-xray-control-server. /etc stays writable too so a
# first start can still generate the cert if `setup` was skipped.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
ReadWritePaths=/etc/keenetic-xray-control-server /var/lib/keenetic-xray-control-server

[Install]
WantedBy=multi-user.target
