#!/bin/sh
set -e

# Best-effort: fetch the vendored (or Entware) xray-core. Not fatal -- a
# router offline at install time still gets a working package; `keenetic-xray
# doctor` reports the missing core and the command below retries it.
/opt/sbin/keenetic-xray internal ensure-xray-core \
    || echo "keenetic-xray: xray-core not installed yet -- run: keenetic-xray internal ensure-xray-core"

/opt/sbin/keenetic-xray internal postinst-setup \
    || echo "keenetic-xray: postinst-setup failed (see above) -- run 'keenetic-xray internal postinst-setup' by hand, then 'keenetic-xray setup'"

# postinst-setup above already best-effort ensures a cron daemon is
# installed/running and writes the watchdog's cron entry (restarts the
# daemon if it's ever not running -- rc.func doesn't do this on its own,
# unlike the control-server's systemd unit). That's all in Go
# (internal/install.EnsureCron/SetWatchdogCron) rather than duplicated
# here in shell, so it stays unit-testable; a router without an
# installable cron just doesn't get the watchdog, same as
# ensure-xray-core's own best-effort framing above.

# Tells applyDaemonChange (called at the end of `setup`) not to restart
# the daemon: postinst starts it itself a few lines below, and rc.func's
# stop matches by process name -- an in-wizard restart would kill the
# running `keenetic-xray setup` process.
export KEENETIC_XRAY_POSTINST=1

# If install.sh was given a link (--sub=/--vless=), do the whole first-run
# configuration here so nothing else is needed. Best-effort: a failure
# (bad URL, offline) just leaves it for `keenetic-xray setup` by hand.
#
# Otherwise, if profiles are already configured, this is an update to an
# already-configured router, not a fresh install -- leave it exactly as
# is and just (re)start below. This can't be decided by whether
# config.json exists (INST-01): postinst-setup above already
# unconditionally wrote an empty-profiles skeleton file if none existed
# yet, so the file is always there by this point regardless of whether a
# real profile has ever been configured -- `internal needs-setup` checks
# len(Profiles) instead, the thing that actually answers the question.
#
# Otherwise, if there's a controlling terminal, run the interactive
# wizard right here -- even under `curl ... | sh`, where install.sh's own
# stdin is the piped script, not the keyboard, so the wizard reads from
# /dev/tty directly instead (same trick server-install.sh already uses
# for the control-server installer). Without a link AND without a tty
# (e.g. driven by cron/CI with stdin/stdout redirected to files), there's
# nothing to prompt into -- leave the daemon idling until `keenetic-xray
# setup` is run by hand, exactly as before this existed.
if [ -n "${KEENETIC_XRAY_SETUP_FROM:-}" ]; then
    _proxy0=--proxy0
    [ -n "${KEENETIC_XRAY_NO_PROXY0:-}" ] && _proxy0=--no-proxy0
    /opt/sbin/keenetic-xray setup --yes "$_proxy0" --from "$KEENETIC_XRAY_SETUP_FROM" \
        || echo "keenetic-xray: auto-setup failed -- run 'keenetic-xray setup' by hand"
elif ! /opt/sbin/keenetic-xray internal needs-setup; then
    # Found live (2026-09-15): without an equivalent check, re-running
    # install.sh with no link on an already-configured router (e.g. the
    # bot's own "Обновить агент" button, which re-runs install.sh with no
    # arguments at all) always fell into the tty branch below. `[ -e
    # /dev/tty ]` only tests that the device node exists, not that
    # anything is actually attached to read from it -- from a
    # backgrounded agent process with no real terminal, `keenetic-xray
    # setup </dev/tty` opened it fine and then blocked forever on its
    # first prompt, holding up the daemon restart below indefinitely
    # (the router was left with the daemon already stopped by this same
    # upgrade and no way to bring it back short of a manual reinstall).
    echo "keenetic-xray: existing config found -- keeping it, skipping setup"
elif [ -e /dev/tty ]; then
    echo "keenetic-xray: no link given -- running the interactive setup wizard"
    _setup_args=""
    [ -n "${KEENETIC_XRAY_NO_PROXY0:-}" ] && _setup_args="--no-proxy0"
    # INST-04: /dev/tty existing as a device node doesn't prove anyone is
    # actually there to answer prompts -- it's the same weak signal the
    # incident above exploited, just via a different route into this
    # branch (already closed). Bound the wait so a still-possible
    # unattended trigger (this script invoked from cron/CI/a
    # provisioning pipeline with a stale controlling terminal) fails
    # fast into the "run by hand" guidance instead of hanging
    # indefinitely. BusyBox's own timeout applet if present; run
    # unprotected otherwise, same "don't require a specific tool"
    # reasoning as this project's curl/wget and sha256sum fallbacks
    # elsewhere.
    # shellcheck disable=SC2086 # _setup_args is "" or one flag word, deliberately unquoted
    if command -v timeout >/dev/null 2>&1; then
        timeout 300 /opt/sbin/keenetic-xray setup $_setup_args </dev/tty \
            || echo "keenetic-xray: setup wizard failed, was cancelled, or timed out waiting for input -- run 'keenetic-xray setup' by hand"
    else
        /opt/sbin/keenetic-xray setup $_setup_args </dev/tty \
            || echo "keenetic-xray: setup wizard failed or was cancelled -- run 'keenetic-xray setup' by hand"
    fi
else
    echo "keenetic-xray: no link and no controlling terminal -- run 'keenetic-xray setup' by hand to finish configuring"
fi

# Start last, so it comes up with the full config -- no restart needed.
# Guarded like every other step above: under `set -e`, an unguarded
# non-zero here would make opkg report the whole install as failed even
# though the package itself is in place -- and, since this is the last
# command in the script, silently skip the "run it by hand" advice a
# user actually needs to recover.
/opt/etc/init.d/S99keenetic-xray start \
    || echo "keenetic-xray: daemon did not start -- run 'keenetic-xray daemon' by hand, or check 'keenetic-xray logs'"

exit 0
