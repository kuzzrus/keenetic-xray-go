+// `strconv.ParseBool: parsing "on": invalid syntax`). Anything else
+// (empty, or already "true"/"false") passes through unchanged.
+func onOffToBool(v string) string {
+	switch strings.ToLower(v) {
+	case "on":
+		return "true"
+	case "off":
+		return "false"
+	default:
+		return v
+	}
