#!/bin/sh
set -e

# Best-effort: fetch the vendored (or Entware) xray-core. Not fatal -- a
# router offline at install time still gets a working package; `keenetic-xray
# doctor` reports the missing core and the command below retries it.
/opt/sbin/keenetic-xray internal ensure-xray-core \
    || echo "keenetic-xray: xray-core not installed yet -- run: keenetic-xray internal ensure-xray-core"

/opt/sbin/keenetic-xray internal postinst-setup

# postinst-setup just wrote the watchdog's cron entry (restarts the
# daemon if it's ever not running -- rc.func doesn't do this on its own,
# unlike the control-server's systemd unit). Best-effort: make sure a
# cron daemon actually exists to read it. Entware doesn't always ship one
# enabled by default, and not fatal either way -- a router without cron
# just doesn't get the watchdog, same as ensure-xray-core above.
# S10cron start is a no-op if cron is already running (rc.func's own
# is-it-already-up guard, same one S99keenetic-xray itself relies on).
if [ -x /opt/etc/init.d/S10cron ]; then
    /opt/etc/init.d/S10cron enable >/dev/null 2>&1 || true
    /opt/etc/init.d/S10cron start >/dev/null 2>&1 || true
elif command -v crond >/dev/null 2>&1; then
    crond >/dev/null 2>&1 || true
elif opkg install cron >/dev/null 2>&1 && [ -x /opt/etc/init.d/S10cron ]; then
    /opt/etc/init.d/S10cron enable >/dev/null 2>&1 || true
    /opt/etc/init.d/S10cron start >/dev/null 2>&1 || true
else
    echo "keenetic-xray: no cron daemon found/installable -- the watchdog cron entry is written but won't run until one exists"
fi

# If install.sh was given a link (--sub=/--vless=), do the whole first-run
# configuration here so nothing else is needed. Best-effort: a failure
# (bad URL, offline) just leaves it for `keenetic-xray setup` by hand.
#
# Otherwise, if there's a controlling terminal, run the interactive
# wizard right here -- even under `curl ... | sh`, where install.sh's own
# stdin is the piped script, not the keyboard, so the wizard reads from
# /dev/tty directly instead (same trick server-install.sh already uses
# for the control-server installer). Without a link AND without a tty
# (e.g. driven by cron/CI with stdin/stdout redirected to files), there's
# nothing to prompt into -- leave the daemon idling until `keenetic-xray
# setup` is run by hand, exactly as before this existed.
if [ -n "${KEENETIC_XRAY_SETUP_FROM:-}" ]; then
    _proxy0=--proxy0
    [ -n "${KEENETIC_XRAY_NO_PROXY0:-}" ] && _proxy0=--no-proxy0
    /opt/sbin/keenetic-xray setup --yes "$_proxy0" --from "$KEENETIC_XRAY_SETUP_FROM" \
        || echo "keenetic-xray: auto-setup failed -- run 'keenetic-xray setup' by hand"
elif [ -e /dev/tty ]; then
    echo "keenetic-xray: no link given -- running the interactive setup wizard"
    if [ -n "${KEENETIC_XRAY_NO_PROXY0:-}" ]; then
        /opt/sbin/keenetic-xray setup --no-proxy0 </dev/tty \
            || echo "keenetic-xray: setup wizard failed or was cancelled -- run 'keenetic-xray setup' by hand"
    else
        /opt/sbin/keenetic-xray setup </dev/tty \
            || echo "keenetic-xray: setup wizard failed or was cancelled -- run 'keenetic-xray setup' by hand"
    fi
else
    echo "keenetic-xray: no link and no controlling terminal -- run 'keenetic-xray setup' by hand to finish configuring"
fi

# Start last, so it comes up with the full config -- no restart needed.
/opt/etc/init.d/S99keenetic-xray start

exit 0
